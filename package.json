{
  "name": "aileslyonnaises",
  "version": "0.1.0",
  "description": "Site public de l’Aéroclub Les Ailes Lyonnaises",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "studio": "sanity dev --config studio/sanity.config.ts",
    "studio:build": "sanity build studio/dist --config studio/sanity.config.ts"
  },
  "keywords": [
    "aeroclub",
    "astro",
    "sanity"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@sanity/client": "^7.25.0",
    "astro": "^7.1.3",
    "resend": "^6.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/workers-types": "^5.20260724.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "eslint": "^10.8.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanity": "^6.6.0",
    "styled-components": "^6.4.4",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
