---
import CtaBand from "@/components/CtaBand.astro";
import PageHero from "@/components/PageHero.astro";
import PersonCard from "@/components/PersonCard.astro";
import { getPeople, getStories } from "@/lib/cms";
import { portableTextPlain } from "@/lib/cms/portableText";
import { isBoardMember, isBureauMember } from "@/lib/cms/roles";
import BaseLayout from "@/layouts/BaseLayout.astro";

const stories = await getStories();
const people = await getPeople();
const clubStories = stories.filter((story) => story.category !== "elles");
const ellesStories = stories.filter((story) => story.category === "elles");
const bureau = people.filter(isBureauMember);
const board = people.filter(isBoardMember);
const categoryLabels = {
  history: "Histoire",
  clubLife: "Vie du club",
  trip: "Voyage",
  elles: "Les Elles Lyonnaises",
} as const;
const storyFallbacks = {
  history: "/images/landscapes/lyon-tete-or.webp",
  clubLife: "/images/landscapes/dombes.webp",
  trip: "/images/landscapes/aiguille-midi.webp",
  elles: "/images/landscapes/lyon-tete-or.webp",
} as const;

interface Partner {
  label: string;
  href: string;
  logo?: string;
  logoAlt?: string;
}

const partners: Partner[] = [
  {
    label: "Fédération Française Aéronautique",
    href: "https://ffa-aero.fr/",
    logo: "/images/partners/ffa.webp",
    logoAlt: "Fédération Française Aéronautique",
  },
  {
    label: "Comité Régional Aéronautique Auvergne-Rhône-Alpes",
    href: "https://www.cra01ffa.fr/",
  },
  {
    label: "ALYBRA — Amis de Lyon Bron Aéroport",
    href: "https://alybra.fr/",
    logo: "/images/partners/alybra.webp",
    logoAlt: "ALYBRA — Amis de Lyon Bron Aéroport",
  },
  {
    label: "Musée de l’aviation de Lyon-Corbas",
    href: "https://museeaviationlyon.fr/",
    logo: "/images/partners/musee-corbas.webp",
    logoAlt: "Musée de l’Aviation Clément Ader",
  },
  {
    label:
      "SLHADA — Société Lyonnaise d’Histoire de l’Aviation et de Documentation Aéronautique",
    href: "https://www.slhada.fr/",
    logo: "/images/partners/slhada.webp",
    logoAlt:
      "Société Lyonnaise d’Histoire de l’Aviation et de Documentation Aéronautique",
  },
];
---

<BaseLayout
  title="Vie du club"
  description="Découvrez l’histoire, les voyages, la communauté, Les Elles Lyonnaises et le réseau de l’Aéroclub Les Ailes Lyonnaises à Lyon-Bron."
>
  <PageHero
    eyebrow="Plus qu’une école"
    title="Une communauté qui partage le ciel"
    introduction="Élèves, pilotes, instructeurs et bénévoles font vivre une association où l’expérience circule et les projets se construisent ensemble."
    image="/images/landscapes/aiguille-midi.webp"
    imageAlt="Le massif du Mont-Blanc vu lors d’un vol"
  />

  <section class="section section--white">
    <div class="container split">
      <img
        class="split__image"
        src="/images/club/barbecue-animation.webp"
        alt="Animation associative des Ailes Lyonnaises : membres réunis autour des tables pour un moment convivial"
        width="1024"
        height="768"
        loading="lazy"
      />
      <div>
        <p class="eyebrow">L’esprit du club</p>
        <h2>Voler ensemble, progresser ensemble.</h2>
        <p class="lede">
          La vie associative ne s’arrête pas après l’atterrissage. Préparation
          de voyages, retours d’expérience, rencontres et projets collectifs
          donnent aux membres de nouvelles raisons de venir au terrain.
        </p>
      </div>
    </div>
  </section>

  <section id="recits" class="section">
    <div class="container">
      <p class="eyebrow">Récits du club</p>
      <h2>Des destinations qui deviennent des expériences partagées.</h2>
      <div class="grid grid--3 story-grid">
        {
          clubStories.map((story) => (
            <a class="media-card" href={`/vie-du-club/${story.slug}/`}>
              <img
                class="media-card__image"
                src={story.image?.url ?? storyFallbacks[story.category]}
                alt={story.image?.alt ?? ""}
                width="2048"
                height="1365"
                loading="lazy"
              />
              <div class="media-card__body">
                <span class="tag">{categoryLabels[story.category]}</span>
                <h3>{story.title}</h3>
                <p>{story.excerpt}</p>
                <span class="story-link">Lire le récit</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {
    ellesStories.length > 0 && (
      <section class="section section--white">
        <div class="container">
          <p class="eyebrow">Les Elles Lyonnaises</p>
          <h2>Trois figures qui ont ouvert le ciel.</h2>
          <div class="elles-list">
            {ellesStories.map((story) => (
              <article class="elles-card">
                <img
                  src={story.image?.url ?? storyFallbacks.elles}
                  alt={story.image?.alt ?? ""}
                  width="1600"
                  height="1100"
                  loading="lazy"
                />
                <div>
                  <h3>{story.title}</h3>
                  {story.body.map((block) =>
                    block.style === "blockquote" ? (
                      <blockquote>{portableTextPlain(block)}</blockquote>
                    ) : (
                      <p>{portableTextPlain(block)}</p>
                    ),
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    bureau.length > 0 && (
      <section class="section">
        <div class="container">
          <p class="eyebrow">Bureau</p>
          <h2>Les responsables élus de l’association.</h2>
          <div class="governance-grid">
            {bureau.map((person) => (
              <PersonCard person={person} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    board.length > 0 && (
      <section class="section section--white">
        <div class="container">
          <p class="eyebrow">Conseil d’administration</p>
          <h2>Les administrateurs au service du club.</h2>
          <div class="governance-grid">
            {board.map((person) => (
              <PersonCard person={person} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section section--navy">
    <div class="container split">
      <div>
        <p class="eyebrow">Depuis 1965</p>
        <h2>Un club né pour démocratiser les sports aériens.</h2>
        <p class="lede">
          L’Aéro-club des Jeunes de Monplaisir-Lumière développe d’abord ses
          activités à Satolas. Au début de la construction du futur aéroport
          Lyon-Saint-Exupéry, il rejoint Bron.
        </p>
      </div>
      <div class="history">
        <div><strong>1965</strong><span>Création du club à Lyon</span></div>
        <div>
          <strong>Bron</strong><span
            >Installation sur la plateforme historique</span
          >
        </div>
        <div>
          <strong>1978</strong><span
            >Le club devient « Les Ailes Lyonnaises »</span
          >
        </div>
      </div>
    </div>
  </section>

  <section class="section section--white partner-section">
    <div class="container">
      <div class="split section-heading">
        <div>
          <p class="eyebrow">Notre réseau</p>
          <h2>Une association inscrite dans son territoire.</h2>
        </div>
        <p class="lede">
          Le club est affilié à la FFA et travaille avec des partenaires locaux
          de l’aviation lyonnaise.
        </p>
      </div>
      <ul class="partner-list">
        {
          partners.map((partner) => (
            <li>
              <a
                class:list={{ "partner--without-logo": !partner.logo }}
                href={partner.href}
                aria-label={partner.label}
                target="_blank"
                rel="noopener noreferrer external"
              >
                {partner.logo && (
                  <img
                    src={partner.logo}
                    alt={partner.logoAlt ?? ""}
                    width="220"
                    height="96"
                    loading="lazy"
                  />
                )}
                {!partner.logo && <span>{partner.label}</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand
    title="La meilleure façon de comprendre le club est de venir."
    text="Passez nous rencontrer à Lyon-Bron, voir les avions et échanger avec les membres présents."
    href="/contact/"
    label="Préparer ma visite"
  />
</BaseLayout>

<style>
  .story-grid,
  .elles-list,
  .governance-grid,
  .section-heading {
    margin-top: 2.5rem;
  }

  .elles-list {
    display: grid;
    gap: 2.5rem;
  }

  .elles-card {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    grid-template-columns: minmax(12rem, 18rem) minmax(0, 1fr);
    align-items: start;
  }

  .elles-card img {
    width: 100%;
    height: 16rem;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .elles-card h3 {
    margin-bottom: 1rem;
  }

  .elles-card p,
  .elles-card blockquote {
    color: var(--muted);
    line-height: 1.7;
  }

  .elles-card blockquote {
    margin: 1rem 0;
    padding-left: 1rem;
    color: var(--navy-900);
    border-left: 4px solid var(--yellow-500);
    font-style: italic;
  }

  .story-link {
    color: var(--yellow-400);
    font-size: 0.82rem;
    font-weight: 800;
  }

  .governance-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }

  .history {
    display: grid;
    gap: 1rem;
  }

  .history div {
    display: grid;
    padding: 1.4rem 0;
    border-top: 1px solid rgb(255 255 255 / 0.2);
  }

  .history strong {
    color: var(--yellow-400);
    font-size: clamp(2rem, 5vw, 4rem);
  }

  .history span {
    color: rgb(255 255 255 / 0.68);
  }

  .partner-section {
    padding-block: clamp(2.5rem, 4vw, 3.5rem);
  }

  .partner-section .section-heading {
    gap: 0.75rem;
    grid-template-columns: 1fr;
    margin-top: 0;
  }

  .partner-section h2 {
    margin-bottom: 0;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
  }

  .partner-section .lede {
    max-width: 50rem;
    font-size: 1rem;
  }

  .partner-list {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    padding: 0;
    margin: 1.5rem 0 0;
    list-style: none;
  }

  .partner-list a {
    display: flex;
    min-height: 4rem;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    color: var(--navy-900);
    text-decoration: none;
  }

  .partner-list a::after {
    content: none;
  }

  .partner-list img {
    width: 100%;
    max-width: 8rem;
    height: 3.5rem;
    object-fit: contain;
    object-position: center;
  }

  .partner-list .partner--without-logo {
    text-align: center;
  }

  .partner-list span {
    max-width: 12rem;
    font-size: 0.78rem;
    font-weight: 800;
    line-height: 1.35;
  }

  @media (max-width: 52rem) {
    .elles-card {
      grid-template-columns: 1fr;
    }

    .partner-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .governance-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 52.01rem) and (max-width: 72rem) {
    .governance-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 32rem) {
    .governance-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
