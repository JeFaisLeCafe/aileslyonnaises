---
import CtaBand from "@/components/CtaBand.astro";
import PageHero from "@/components/PageHero.astro";
import { getStories } from "@/lib/cms";
import { portableTextPlain } from "@/lib/cms/portableText";
import type { Story, StoryCategory } from "@/lib/cms";
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  story: Story;
}

const categoryLabels: Record<StoryCategory, string> = {
  history: "Histoire",
  clubLife: "Vie du club",
  trip: "Voyage",
  elles: "Les Elles Lyonnaises",
};

const storyFallbacks: Record<StoryCategory, string> = {
  history: "/images/landscapes/lyon-tete-or.webp",
  clubLife: "/images/landscapes/dombes.webp",
  trip: "/images/landscapes/aiguille-midi.webp",
  elles: "/images/landscapes/lyon-tete-or.webp",
};

export async function getStaticPaths() {
  const stories = await getStories();

  return stories.map((story) => ({
    params: { slug: story.slug },
    props: { story },
  }));
}

const { story } = Astro.props;
const image = story.image?.url ?? storyFallbacks[story.category];
const imageAlt = story.image?.alt ?? "";
---

<BaseLayout title={story.title} description={story.excerpt}>
  <PageHero
    eyebrow={categoryLabels[story.category]}
    title={story.title}
    introduction={story.excerpt}
    image={image}
    imageAlt={imageAlt}
    longTitle
  />

  <article class="section section--white story">
    <div class="narrow">
      <a class="text-link story__back" href="/vie-du-club/#recits">
        Retour aux récits
      </a>
      {
        story.body.map((block) => {
          const text = portableTextPlain(block);

          if (block.style === "h2") return <h2>{text}</h2>;
          if (block.style === "h3") return <h3>{text}</h3>;
          if (block.style === "blockquote")
            return <blockquote>{text}</blockquote>;
          return <p>{text}</p>;
        })
      }
    </div>
  </article>

  <CtaBand
    title="Une histoire à partager avec le club ?"
    text="Rencontrez les membres à Lyon-Bron et découvrez les prochains projets collectifs."
    href="/contact/"
    label="Nous rencontrer"
  />
</BaseLayout>

<style>
  .story__back {
    display: inline-flex;
    margin-bottom: 2.5rem;
  }

  .story p,
  .story blockquote {
    color: #344054;
    font-size: 1.08rem;
    line-height: 1.8;
  }

  .story h2,
  .story h3 {
    margin-top: 2.5rem;
  }

  .story blockquote {
    margin: 2rem 0;
    padding-left: 1.25rem;
    color: var(--navy-900);
    border-left: 4px solid var(--yellow-500);
    font-style: italic;
  }
</style>
