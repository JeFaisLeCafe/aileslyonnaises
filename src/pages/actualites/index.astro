---
import CtaBand from "@/components/CtaBand.astro";
import PageHero from "@/components/PageHero.astro";
import { getNews } from "@/lib/cms";
import BaseLayout from "@/layouts/BaseLayout.astro";

const articles = await getNews();
const date = (value: string) =>
  new Intl.DateTimeFormat("fr-FR", {
    dateStyle: "long",
    timeZone: "Europe/Paris",
  }).format(new Date(value));
---

<BaseLayout
  title="Actualités"
  description="Les actualités de l’Aéroclub Les Ailes Lyonnaises : vie du club, flotte, formations et rendez-vous à Lyon-Bron."
>
  <PageHero
    eyebrow="Le club en mouvement"
    title="Actualités des Ailes Lyonnaises"
    introduction="Retrouvez les navigations, rendez-vous et nouvelles du club. Ouvrez une actualité pour lire son récit et voir toutes ses photos."
    compact
  />

  <section class="section section--white">
    <div class="container">
      {
        articles.length === 0 ? (
          <p class="lede">
            Aucune actualité n’est publiée pour le moment. La vie associative,
            l’histoire du club et les récits se trouvent sur la page
            <a class="text-link" href="/vie-du-club/">
              Vie du club
            </a>
            .
          </p>
        ) : (
          <div class="news-grid">
            {articles.map((article, index) => {
              const image = article.image ?? article.gallery[0];

              return (
                <a
                  class:list={[
                    "news-card",
                    { "news-card--featured": index === 0 },
                  ]}
                  href={`/actualites/${article.slug}/`}
                >
                  {image && (
                    <figure class="news-card__media">
                      <img
                        src={image.url}
                        alt={image.alt}
                        width="1600"
                        height="900"
                        loading={index === 0 ? "eager" : "lazy"}
                      />
                    </figure>
                  )}
                  <div class="news-card__content">
                    <p class="eyebrow">{date(article.publishedAt)}</p>
                    <h2>{article.title}</h2>
                    <p>{article.excerpt}</p>
                    <span class="text-link">Lire l’actualité</span>
                  </div>
                </a>
              );
            })}
          </div>
        )
      }
    </div>
  </section>

  <CtaBand
    title="Une question, un projet, une visite ?"
    text="Le formulaire de formation et les coordonnées du club restent le moyen le plus direct de nous joindre."
    href="/contact/"
    label="Contacter le club"
  />
</BaseLayout>

<style>
  .news-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .news-card {
    display: grid;
    min-width: 0;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .news-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-0.2rem);
  }

  .news-card--featured {
    grid-column: 1 / -1;
    grid-template-columns: minmax(0, 1.15fr) minmax(20rem, 0.85fr);
  }

  .news-card__media {
    display: grid;
    min-height: 16rem;
    place-items: center;
    padding: 1rem;
    margin: 0;
    background: var(--white);
  }

  .news-card__media img {
    width: 100%;
    height: auto;
    max-height: 34rem;
    object-fit: contain;
  }

  .news-card__content {
    align-content: center;
    padding: clamp(1.4rem, 4vw, 2.5rem);
  }

  .news-card h2 {
    margin-bottom: 0.75rem;
    font-size: clamp(1.6rem, 3vw, 2.5rem);
  }

  .news-card__content > p:not(.eyebrow) {
    color: var(--muted);
  }

  .news-card .text-link {
    display: inline-block;
    margin-top: 0.75rem;
  }

  @media (max-width: 48rem) {
    .news-grid,
    .news-card--featured {
      grid-template-columns: 1fr;
    }

    .news-card--featured {
      grid-column: auto;
    }
  }
</style>
