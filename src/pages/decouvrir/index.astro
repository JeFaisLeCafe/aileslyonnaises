---
import CtaBand from "@/components/CtaBand.astro";
import PageHero from "@/components/PageHero.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Découvrir le vol"
  description="Vol découverte et pack initiation au départ de Lyon-Bron : survolez la région lyonnaise ou prenez les commandes avec un instructeur."
>
  <PageHero
    eyebrow="Premières expériences"
    title="Découvrir le ciel au départ de Lyon-Bron"
    introduction="Offrez-vous le paysage, partagez-le avec vos proches ou commencez une première leçon de pilotage."
    image="/images/landscapes/dombes.webp"
    imageAlt="Les étangs de la Dombes vus depuis un avion"
  >
    <div class="button-row">
      <a class="button" href="#formules">Voir les formules</a>
      <a class="button button--ghost" href="/contact/">Poser une question</a>
    </div>
  </PageHero>

  <section id="formules" class="section section--white">
    <div class="container">
      <p class="eyebrow">Deux façons de commencer</p>
      <h2>Regarder le paysage ou apprendre à tenir le cap.</h2>
      <div class="grid grid--2 offers">
        <article class="offer">
          <div class="offer__number">01</div>
          <div>
            <span class="tag">30 min · 2 passagers maximum</span>
            <h3>Vol découverte</h3>
            <p>
              Un pilote expérimenté vous emmène au nord, au sud ou à l’ouest de
              Lyon. Vous profitez du paysage et découvrez l’environnement du vol
              léger depuis la meilleure place.
            </p>
            <p class="offer__note">
              Le parcours exact dépend des conditions météorologiques et des
              contraintes aéronautiques du jour.
            </p>
            <a class="text-link" href="/contact/">Demander les disponibilités</a>
          </div>
        </article>
        <article id="initiation" class="offer">
          <div class="offer__number">02</div>
          <div>
            <span class="tag">Avec un instructeur</span>
            <h3>Pack initiation</h3>
            <p class="offer__hook">Et si le pilote, c’était vous ?</p>
            <p>
              Une première expérience de formation pour ressentir concrètement
              ce qu’est une leçon de pilotage. Le pack comprend :
            </p>
            <ul class="offer__list">
              <li>
                Votre inscription comme membre de notre aéroclub pour l’année en
                cours
              </li>
              <li>
                Votre assurance Pilote auprès de la FFA (Fédération Française
                Aéronautique) valable pour l’année en cours
              </li>
              <li>
                4 leçons de vol de 30 minutes chacune avec un instructeur ou une
                instructrice du club
              </li>
              <li>
                4 briefings et débriefings de 30 minutes à l’occasion de chaque
                vol
              </li>
            </ul>
            <p class="offer__note">
              L’inscription à notre aéroclub, valable jusqu’au 31 décembre de
              l’année en cours, vous permet de participer aux activités proposées
              par les animateurs du groupe VAC (Voyages, Animations,
              Communication) : balades, voyages, vols techniques de découverte
              (vol de nuit, vol aux instruments…).
            </p>
            <a class="text-link" href="/contact/#formation"
              >Parler de l’initiation</a
            >
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Au départ de Lyon-Bron</p>
      <h2>Trois directions, une région spectaculaire.</h2>
      <div class="grid grid--3">
        <article class="route-card">
          <span>Nord</span>
          <h3>La Dombes</h3>
          <p>Un paysage d’étangs, de bocage et de villages au nord de Lyon.</p>
        </article>
        <article class="route-card">
          <span>Sud</span>
          <h3>Vallée du Rhône</h3>
          <p>Les reliefs et les grands axes naturels qui s’ouvrent au sud.</p>
        </article>
        <article class="route-card">
          <span>Ouest</span>
          <h3>Lyon et ses reliefs</h3>
          <p>Une lecture aérienne de la métropole et de l’ouest lyonnais.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container split">
      <img
        class="split__image"
        src="/images/landscapes/lyon-tete-or.webp"
        alt="Lyon et le parc de la Tête d’Or vus du ciel"
        width="2048"
        height="1365"
        loading="lazy"
      />
      <div>
        <p class="eyebrow">Offrir un vol</p>
        <h2>Le plus beau des cadeaux n’est pas un objet, c’est une émotion !</h2>
        <p class="lede">
          Un bon cadeau sera édité et il vous restera à nous contacter pour fixer
          un rendez-vous.
        </p>
        <a class="button" href="/contact/">Nous contacter</a>
      </div>
    </div>
  </section>

  <CtaBand
    title="Vous hésitez entre découverte et initiation ?"
    text="Dites-nous si vous voulez surtout profiter du paysage ou commencer à apprendre : nous vous orienterons vers la bonne formule."
    href="/contact/"
    label="Contacter le club"
  />
</BaseLayout>

<style>
  .offers {
    margin-top: 3rem;
  }

  .offer {
    display: grid;
    align-items: start;
    gap: 1.5rem;
    grid-template-columns: auto 1fr;
    padding: clamp(1.5rem, 4vw, 3rem);
    background: var(--paper);
    border-radius: var(--radius-lg);
  }

  .offer__number {
    color: var(--navy-800);
    font-size: 0.8rem;
    font-weight: 900;
  }

  .offer h3 {
    margin: 1.25rem 0 0.75rem;
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .offer__hook {
    margin: 0 0 1rem;
    color: var(--navy-900);
    font-size: 1.15rem;
    font-weight: 800;
  }

  .offer p {
    color: var(--muted);
    line-height: 1.7;
  }

  .offer__list {
    margin: 1rem 0 0;
    padding-left: 1.1rem;
    color: var(--muted);
    line-height: 1.6;
  }

  .offer__list li + li {
    margin-top: 0.55rem;
  }

  .offer__note {
    padding-top: 1rem;
    font-size: 0.82rem;
    border-top: 1px solid var(--line);
  }

  .route-card {
    min-height: 20rem;
    padding: 2rem;
    color: var(--white);
    background:
      linear-gradient(rgb(3 23 53 / 0.35), rgb(3 23 53 / 0.68)),
      url("/images/landscapes/dombes.webp") center / cover;
    border-radius: var(--radius-md);
  }

  .route-card:nth-child(2) {
    background:
      linear-gradient(rgb(3 23 53 / 0.35), rgb(3 23 53 / 0.68)),
      url("/images/landscapes/aiguille-midi.webp") center / cover;
  }

  .route-card:nth-child(3) {
    background:
      linear-gradient(rgb(3 23 53 / 0.35), rgb(3 23 53 / 0.68)),
      url("/images/landscapes/lyon-tete-or.webp") center / cover;
  }

  .route-card span {
    color: var(--yellow-400);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .route-card h3 {
    margin-top: 8rem;
    color: var(--white);
  }

  .route-card p {
    color: rgb(255 255 255 / 0.82);
  }
</style>
