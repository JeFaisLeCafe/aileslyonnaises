---
import CtaBand from "@/components/CtaBand.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  getAircraft,
  getNews,
  getSiteData,
  getTrainingPrograms,
} from "@/lib/cms";

const aircraft = await getAircraft();
const latestNews = (await getNews())[0];
const siteData = await getSiteData();
const trainingPrograms = await getTrainingPrograms();
const schoolAircraft = aircraft.find(
  ({ registration }) => registration === "F-HLYO",
);
const welcomeClubName = siteData.clubName.startsWith("Aéroclub ")
  ? `l’${siteData.clubName}`
  : siteData.clubName;
const minimumHours = (slug: string) =>
  trainingPrograms.find((program) => program.slug === slug)?.minimumFlightHours;
const fallbackImages: Record<string, string> = {
  "F-HSMB": "/images/aircraft/bristell-b23.webp",
  "F-GXGE": "/images/aircraft/dr400-gxge.webp",
  "F-GJQT": "/images/aircraft/dr400-gjqt.webp",
  "F-HLYO": "/images/aircraft/dr401-hlyo.webp",
  "F-GYPG": "/images/aircraft/dr400-gypg.webp",
  "F-HGBN": "/images/aircraft/velis-electro.webp",
};
---

<BaseLayout
  title={siteData.clubName}
  description="Aéroclub et école de pilotage approuvée ATO à Lyon-Bron. Découvrez le vol, préparez votre PPL ou LAPL et rejoignez une communauté de pilotes."
>
  <section class="home-hero">
    <div class="home-hero__media" aria-hidden="true">
      <img
        class="home-hero__image"
        src="/images/landscapes/lyon-tete-or.webp"
        alt=""
        width="2048"
        height="1365"
        fetchpriority="high"
      />
      <iframe
        class="home-hero__video"
        src="https://player.vimeo.com/video/236426046?background=1&autoplay=1&loop=1&muted=1&autopause=0&dnt=1"
        title="Vidéo de présentation de l’aéroclub"
        allow="autoplay; fullscreen; picture-in-picture"
        loading="eager"
        referrerpolicy="strict-origin-when-cross-origin"></iframe>
    </div>
    <div class="home-hero__overlay"></div>
    <div class="container home-hero__content">
      <p class="eyebrow">{siteData.locationLabel}</p>
      <h1>
        Bienvenue à
        <span class="display-serif">{welcomeClubName}</span>
      </h1>
      <p class="lede">
        École de pilotage approuvée FR.ATO.0078. Rejoignez une communauté
        d’élèves et de pilotes passionnés et découvrez la liberté du vol.
      </p>
      <div class="button-row">
        <a class="button" href="/apprendre/">Apprendre à piloter</a>
        <a class="button button--ghost" href="/decouvrir/">Vol découverte</a>
      </div>
    </div>
    <a class="home-hero__scroll" href="#commencer">Explorer <span>↓</span></a>
  </section>

  <section id="commencer" class="section section--white">
    <div class="container split">
      <div>
        <p class="eyebrow">Découvrir</p>
        <h2>Et si le pilote, c’était vous ?</h2>
      </div>
      <div>
        <p class="lede">
          Offrez-vous ou offrez un vol en avion. Une expérience unique et
          accessible à tous.
        </p>
        <a class="text-link" href="/decouvrir/"
          >Choisir une première expérience</a
        >
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Deux portes d’entrée</p>
      <h2>Vivez le vol à votre rythme.</h2>
      <div class="grid grid--2 experience-grid">
        <a class="experience" href="/decouvrir/">
          <img
            src="/images/landscapes/dombes.webp"
            alt="Les étangs de la Dombes vus depuis un avion"
            width="2048"
            height="1365"
            loading="lazy"
          />
          <div class="experience__content">
            <span class="tag">30 minutes · jusqu’à 2 passagers</span>
            <h3>Découvrir la région vue du ciel</h3>
            <p>
              Un survol accompagné au nord, au sud ou à l’ouest de Lyon avec un
              pilote expérimenté.
            </p>
            <span class="text-link">Découvrir les parcours</span>
          </div>
        </a>
        <a class="experience" href="/apprendre/">
          <img
            src="/images/aircraft/bristell-cockpit.webp"
            alt="Glass cockpit du Bristell B23 des Ailes Lyonnaises"
            width="2200"
            height="1466"
            loading="lazy"
          />
          <div class="experience__content">
            <span class="tag">PPL · LAPL · Vol de nuit</span>
            <h3>Prendre les commandes</h3>
            <p>
              Un premier cours avec un instructeur, puis une formation
              construite autour de votre projet.
            </p>
            <span class="text-link">Comprendre les formations</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--navy">
    <div class="container split">
      <div>
        <p class="eyebrow">École de pilotage FR.ATO.0078</p>
        <h2>Apprendre à piloter</h2>
        <p class="lede">
          Notre école de pilotage agréée ATO accompagne élèves et pilotes à
          Lyon-Bron. Choisissez la formation adaptée à vos ambitions : PPL, LAPL
          ou vol de nuit.
        </p>
        <div class="stats">
          <div class="stat">
            <strong>{minimumHours("ppl") ?? 45} h</strong>
            <span>minimum PPL</span>
          </div>
          <div class="stat">
            <strong>{minimumHours("lapl") ?? 30} h</strong>
            <span>minimum LAPL</span>
          </div>
          <div class="stat">
            <strong>{aircraft.length}</strong><span>avions au club</span>
          </div>
        </div>
        <div class="button-row">
          <a class="button" href="/apprendre/">Voir les parcours</a>
          <a class="button button--ghost" href="/tarifs/"
            >Comprendre les coûts</a
          >
        </div>
      </div>
      <img
        class="split__image"
        src={schoolAircraft?.image?.url ?? "/images/aircraft/dr401-side.webp"}
        alt={schoolAircraft?.image?.alt ??
          "Robin DR401 F-HLYO de profil sur le tarmac"}
        width="2200"
        height="1466"
        loading="lazy"
      />
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <div class="split section-heading">
        <div>
          <p class="eyebrow">La flotte</p>
          <h2>{aircraft.length} avions, du premier tour de piste au voyage.</h2>
        </div>
        <p class="lede">
          Des avions adaptés à l’école, aux navigations et aux voyages, avec des
          équipements modernes et des tarifs associatifs transparents.
        </p>
      </div>
      <div class="grid grid--3">
        {
          aircraft.map((plane) => (
            <article class="card fleet-card">
              <img
                src={plane.image?.url ?? fallbackImages[plane.registration]}
                alt={
                  plane.image?.alt ??
                  `${plane.model} immatriculé ${plane.registration}`
                }
                width="1600"
                height="1066"
                loading="lazy"
              />
              <div class="fleet-card__content">
                <span class="tag">
                  {plane.uses.length > 0
                    ? plane.uses.join(" & ")
                    : "Électrique"}
                </span>
                {plane.registration && (
                  <p class="fleet-card__registration">{plane.registration}</p>
                )}
                <h3>{plane.model}</h3>
                <p>{plane.summary}</p>
              </div>
            </article>
          ))
        }
      </div>
      <div class="button-row">
        <a class="button button--ghost" href="/flotte/">Voir toute la flotte</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split split--reverse">
      <img
        class="split__image"
        src="/images/landscapes/aiguille-midi.webp"
        alt="L’Aiguille du Midi et le massif du Mont-Blanc vus en vol"
        width="2048"
        height="1365"
        loading="eager"
      />
      <div>
        <p class="eyebrow">Vie du club</p>
        <h2>On apprend seul aux commandes, jamais seul au club.</h2>
        <p class="lede">
          Navigations, voyages, partage d’expérience et projets collectifs : les
          Ailes Lyonnaises sont d’abord une association où élèves et pilotes
          font vivre la même passion.
        </p>
        <a class="text-link" href="/vie-du-club/">Découvrir la communauté</a>
      </div>
    </div>
  </section>

  {
    latestNews && (
      <section class="section section--white">
        <div class="container split">
          <div>
            <p class="eyebrow">Actualités</p>
            <h2>{latestNews.title}</h2>
            <p class="lede">{latestNews.excerpt}</p>
            <a class="text-link" href="/actualites/">
              Lire les actualités
            </a>
          </div>
          <figure class="news-teaser">
            <img
              src={
                latestNews.image?.url ?? "/images/club/barbecue-animation.webp"
              }
              alt={
                latestNews.image?.alt ??
                "Membres des Ailes Lyonnaises réunis autour d’un moment convivial"
              }
              width="1024"
              height="768"
              loading="lazy"
            />
            <figcaption>À la une</figcaption>
          </figure>
        </div>
      </section>
    )
  }

  <section class="section section--white">
    <div class="container split">
      <div>
        <p class="eyebrow">Programme jeunes</p>
        <h2>Le BIA, une première porte vers l’aéronautique.</h2>
        <p class="lede">
          Nos pilotes titulaires du CAEA interviennent auprès d’établissements
          partenaires et accompagnent les vols de découverte liés au Brevet
          d’Initiation Aéronautique.
        </p>
        <div class="button-row">
          <a class="text-link" href="/bia/">Comprendre le programme BIA</a>
          <a
            class="text-link"
            href="https://www.ffa-aero.fr/fr/frm_decouvrir_aidesffapourjeunespilotes.awp"
            target="_blank"
            rel="noopener noreferrer external"
          >
            Découvrir les aides de la FFA
          </a>
        </div>
      </div>
      <div class="bia-card">
        <span>BIA</span>
        <strong>Théorie, culture aéronautique et découverte du vol</strong>
        <a
          class="ffa-mark"
          href="https://ffa-aero.fr/"
          rel="noopener noreferrer external"
        >
          Membre FFA
        </a>
      </div>
    </div>
  </section>

  <CtaBand
    title="Votre projet de pilote commence par une conversation."
    text="Parlez-nous de votre objectif, de vos disponibilités et de votre expérience. L’équipe formation vous aidera à choisir le bon parcours."
    href="/contact/#formation"
    label="Parler de ma formation"
  />
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    display: grid;
    min-height: min(80rem, calc(100svh - var(--header-height)));
    align-items: center;
    overflow: hidden;
    color: var(--white);
    background: var(--navy-950);
  }

  .home-hero__media,
  .home-hero__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .home-hero__media {
    overflow: hidden;
    background: var(--navy-950);
  }

  .home-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(1.12);
  }

  .home-hero__video {
    position: absolute;
    top: 50%;
    left: 50%;
    width: max(100%, 177.78vh);
    height: max(100%, 56.25vw);
    border: 0;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .home-hero__overlay {
    z-index: 1;
    background:
      linear-gradient(
        90deg,
        rgb(2 9 20 / 0.28),
        rgb(2 9 20 / 0.1) 55%,
        rgb(2 9 20 / 0.02)
      ),
      linear-gradient(0deg, rgb(2 9 20 / 0.14), transparent 55%);
  }

  .home-hero__content {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    padding-block: clamp(2.5rem, 6vh, 4rem) clamp(5rem, 10vh, 6rem);
    text-align: center;
    text-shadow: 0 1px 18px rgb(2 9 20 / 0.4);
  }

  .home-hero h1 {
    max-width: 18ch;
    margin-bottom: 1.5rem;
    color: var(--white);
  }

  .home-hero .eyebrow {
    color: var(--yellow-400);
  }

  .home-hero .lede {
    max-width: 42rem;
    color: rgb(255 255 255 / 0.9);
  }

  .home-hero .button-row {
    justify-content: center;
  }

  .home-hero .button--ghost {
    color: var(--white);
    border-color: rgb(255 255 255 / 0.72);
  }

  .home-hero .button--ghost:hover {
    color: var(--navy-950);
    background: var(--white);
  }

  .home-hero__scroll {
    position: absolute;
    z-index: 2;
    bottom: 2rem;
    left: 50%;
    display: grid;
    justify-items: center;
    gap: 0.25rem;
    color: var(--yellow-400);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-decoration: none;
    text-transform: uppercase;
    transform: translateX(-50%);
    text-shadow: 0 2px 16px rgb(2 9 20 / 0.7);
  }

  .home-hero__scroll span {
    font-size: 1.45rem;
    animation: explorer-bounce 1.6s ease-in-out infinite;
  }

  @keyframes explorer-bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(0.35rem);
    }
  }

  .experience-grid {
    margin-top: 2.5rem;
  }

  .experience {
    position: relative;
    min-height: 42rem;
    overflow: hidden;
    color: var(--white);
    background: var(--navy-950);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
  }

  .experience::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgb(3 23 53 / 0.52), transparent 75%);
    content: "";
  }

  .experience img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms ease;
  }

  .experience:hover img {
    transform: scale(1.03);
  }

  .experience__content {
    position: absolute;
    z-index: 1;
    right: 0;
    bottom: 0;
    left: 0;
    padding: clamp(1.5rem, 5vw, 3rem);
  }

  .experience h3 {
    max-width: 15ch;
    margin: 1rem 0;
    color: var(--white);
    font-size: clamp(2rem, 4vw, 3.4rem);
  }

  .experience p {
    max-width: 34rem;
    color: rgb(255 255 255 / 0.76);
    line-height: 1.6;
  }

  .experience .text-link {
    color: var(--yellow-400);
  }

  .section-heading {
    margin-bottom: 2.5rem;
  }

  .card .tag {
    margin-bottom: 2rem;
  }

  .fleet-card {
    padding: 0;
  }

  .fleet-card img {
    width: 100%;
    height: 17rem;
    object-fit: cover;
  }

  .fleet-card__content {
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }

  .fleet-card__content .tag {
    margin-bottom: 1rem;
  }

  .fleet-card__registration {
    margin: 0 0 0.35rem;
    color: var(--muted);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .bia-card {
    display: grid;
    min-height: 26rem;
    align-content: space-between;
    padding: clamp(2rem, 6vw, 4rem);
    color: var(--navy-950);
    background: var(--yellow-500);
    border-radius: var(--radius-lg);
    transform: rotate(1.5deg);
  }

  .bia-card span {
    font-size: clamp(5rem, 12vw, 10rem);
    font-weight: 900;
    letter-spacing: -0.08em;
    line-height: 0.8;
  }

  .bia-card strong {
    max-width: 24rem;
    font-size: clamp(1.3rem, 2.5vw, 2rem);
  }

  .ffa-mark {
    justify-self: start;
    margin-top: 1.5rem;
    color: var(--navy-950);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .news-teaser {
    position: relative;
    margin: 0;
  }

  .news-teaser img {
    width: 100%;
    height: clamp(26rem, 53vw, 42rem);
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .news-teaser figcaption {
    position: absolute;
    left: 1.25rem;
    bottom: 1.25rem;
    padding: 0.45rem 0.8rem;
    color: var(--navy-950);
    background: var(--yellow-500);
    border-radius: 999px;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  @media (max-width: 48rem) {
    .home-hero {
      min-height: calc(100svh - var(--header-height));
    }

    .home-hero__overlay {
      background: linear-gradient(0deg, rgb(2 9 20 / 0.32), rgb(2 9 20 / 0.06));
    }

    .home-hero__content {
      align-self: end;
    }

    .home-hero .button-row {
      width: 100%;
    }

    .home-hero .button {
      width: min(100%, 19rem);
    }

    .experience {
      min-height: 34rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__scroll span {
      animation: none;
    }

    .home-hero__video {
      display: none;
    }
  }
</style>
