---
interface Props {
  eyebrow: string;
  title: string;
  introduction: string;
  image?: string;
  imageAlt?: string;
}

const { eyebrow, title, introduction, image, imageAlt = "" } = Astro.props;
---

<section class:list={["page-hero", { "page-hero--image": image }]}>
  {image && <img class="page-hero__image" src={image} alt={imageAlt} />}
  <div class="page-hero__overlay"></div>
  <div class="container page-hero__content">
    <p class="eyebrow page-hero__eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="lede page-hero__introduction">{introduction}</p>
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    display: grid;
    height: calc(100svh - var(--header-height));
    min-height: 34rem;
    align-items: end;
    overflow: hidden;
    color: var(--white);
    background:
      radial-gradient(
        circle at 80% 20%,
        rgb(91 168 212 / 0.25),
        transparent 35%
      ),
      var(--navy-950);
  }

  .page-hero__image,
  .page-hero__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .page-hero__image {
    object-fit: cover;
  }

  .page-hero__overlay {
    background: linear-gradient(
      90deg,
      rgb(3 23 53 / 0.94) 0%,
      rgb(3 23 53 / 0.72) 52%,
      rgb(3 23 53 / 0.34) 100%
    );
  }

  .page-hero__content {
    position: relative;
    z-index: 1;
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  .page-hero h1 {
    max-width: 13ch;
    margin-bottom: 1.5rem;
    color: var(--white);
    font-size: clamp(3rem, 7vw, 6.4rem);
  }

  .page-hero .page-hero__eyebrow {
    color: var(--yellow-400);
  }

  .page-hero .page-hero__introduction {
    max-width: 42rem;
    color: rgb(255 255 255 / 0.9);
  }

  :global(.page-hero .button--ghost) {
    color: var(--white);
    border-color: rgb(255 255 255 / 0.72);
  }

  :global(.page-hero .button--ghost:hover) {
    color: var(--navy-950);
    background: var(--white);
  }
</style>
