---
import ClubEmail from "@/components/ClubEmail.astro";
import type { SiteData } from "@/lib/cms";

interface Props {
  siteData: SiteData;
}

const { siteData } = Astro.props;
const year = new Date().getFullYear();
const phoneHref = `tel:${siteData.phone.replace(/[^\d+]/g, "")}`;
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <img
        src="/images/brand/logo.png"
        width="256"
        height="256"
        alt={siteData.clubName}
      />
      <p>
        École de pilotage approuvée<br />
        <strong>FR.ATO.0078</strong>
      </p>
    </div>
    <div>
      <h2>Explorer</h2>
      <ul>
        <li><a href="/decouvrir/">Découvrir le vol</a></li>
        <li><a href="/apprendre/">Apprendre à piloter</a></li>
        <li><a href="/apprendre/#parcours">Les parcours</a></li>
        <li><a href="/flotte/">Notre flotte</a></li>
        <li><a href="/tarifs/">Tarifs</a></li>
        <li><a href="/environnement/">Environnement</a></li>
      </ul>
    </div>
    <div>
      <h2>Le club</h2>
      <ul>
        <li><a href="/vie-du-club/">Vie du club</a></li>
        <li><a href="/actualites/">Actualités</a></li>
        <li><a href="/bia/">Programme BIA</a></li>
        <li><a href="/contact/">Nous rencontrer</a></li>
      </ul>
    </div>
    <div>
      <h2>Nous trouver</h2>
      <address>
        {siteData.locationLabel}<br />
        {siteData.address.street}<br />
        {siteData.address.postalCode}
        {siteData.address.city}<br />
        <a href={phoneHref}>{siteData.phone}</a><br />
        <ClubEmail email={siteData.email} variant="dark" />
      </address>
    </div>
  </div>
  <div class="container footer__bottom">
    <span>© {year} {siteData.clubName}</span>
    <nav aria-label="Informations légales">
      <a href="/mentions-legales/">Mentions légales</a>
      <a href="/confidentialite/">Confidentialité</a>
      <a href="/accessibilite/">Accessibilité</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    padding-top: clamp(4rem, 8vw, 7rem);
    color: rgb(255 255 255 / 0.68);
    background: #021127;
  }

  .footer__grid {
    display: grid;
    gap: 3rem;
    grid-template-columns: 1.4fr repeat(3, 1fr);
    padding-bottom: 4rem;
  }

  .footer__brand {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .footer__brand img {
    width: 6.4rem;
    height: 6.4rem;
    object-fit: contain;
  }

  .footer h2 {
    color: var(--white);
    font-size: 0.76rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .footer ul {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .footer li + li {
    margin-top: 0.7rem;
  }

  .footer a {
    text-decoration: none;
  }

  .footer a:hover {
    color: var(--yellow-400);
  }

  address {
    font-style: normal;
    line-height: 1.8;
  }

  .footer__bottom {
    display: flex;
    min-height: 5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    font-size: 0.75rem;
    border-top: 1px solid rgb(255 255 255 / 0.1);
  }

  .footer__bottom nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  @media (max-width: 56rem) {
    .footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 38rem) {
    .footer__grid {
      grid-template-columns: 1fr;
    }

    .footer__bottom {
      align-items: flex-start;
      flex-direction: column;
      padding-block: 1.5rem;
    }
  }
</style>
