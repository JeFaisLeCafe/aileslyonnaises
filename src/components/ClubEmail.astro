---
interface Props {
  email: string;
  variant?: "light" | "dark";
}

const { email, variant = "light" } = Astro.props;
---

<a
  class:list={["club-email", { "club-email--dark": variant === "dark" }]}
  href={`mailto:${email}`}>{email}</a
>

<style>
  .club-email {
    color: var(--navy-800);
  }

  .club-email--dark {
    color: inherit;
  }
</style>
