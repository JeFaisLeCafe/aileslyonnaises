{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Cloudflare Pages project name.
  "name": "aileslyonnaises",
  "compatibility_date": "2026-07-25",
  "pages_build_output_dir": "./dist",
  // Re-add analytics_engine_datasets after enabling Analytics Engine:
